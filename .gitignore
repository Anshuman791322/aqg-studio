# ==============================================================================
# AQG Studio - Git Ignore Rules
# ==============================================================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.pfx
secrets/

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
!frontend/lib/

sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
.venv/
ENV/
env/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Next.js build artifacts
.next/
out/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Uploads, processing storage & exports (Local runtime files)
uploads/
storage/
temp/
exports/
*.tmp

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# Supabase local runtime
supabase/.branches/
supabase/.temp/
