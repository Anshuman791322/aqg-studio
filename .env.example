# ==============================================================================
# AQG Studio - Root Environment Configuration Template (.env.example)
# ==============================================================================
# Duplicate this file to .env for local development. Never commit real credentials.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | staging | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE (Free Tier)
# ------------------------------------------------------------------------------
# Supabase Project API URL & Public Anon Key (for Client & Backend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Supabase Service Role Key (Backend only - privileged operations like batch jobs)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# PostgreSQL Database Connection String (Direct or Transaction Pooler via Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password-placeholder@db.your-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-db-password-placeholder@db.your-project-ref.supabase.co:5432/postgres

# Supabase Storage Bucket Names
SUPABASE_STORAGE_BUCKET_DOCUMENTS=aqg-documents
SUPABASE_STORAGE_BUCKET_EXPORTS=aqg-exports

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Supabase JWT Secret for token verification in FastAPI backend
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 4. PRIMARY LLM PROVIDER: OPENROUTER
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key-placeholder
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# 5. FALLBACK LLM PROVIDER: NVIDIA NIM / API
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your-nvidia-api-key-placeholder
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FALLBACK_MODEL=meta/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# 6. EMBEDDING MODEL CONFIGURATION
# ------------------------------------------------------------------------------
# Free / Local / Fast embedding provider via HuggingFace or OpenAI compatible endpoint
EMBEDDING_PROVIDER=fastembed           # fastembed (local free CPU) | openrouter
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# 7. SYSTEM LIMITS & BUDGETS
# ------------------------------------------------------------------------------
MAX_DOCUMENT_SIZE_MB=50
MAX_PAGES_PER_DOCUMENT=100
MAX_SLIDES_PER_DOCUMENT=50
MAX_QUESTIONS_PER_BATCH=50
LLM_TIMEOUT_SECONDS=60
MAX_AGENT_RETRY_ATTEMPTS=2
