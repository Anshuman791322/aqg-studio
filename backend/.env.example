# ==============================================================================
# AQG Studio - Backend Environment Configuration (.env.example)
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder
JWT_ALGORITHM=HS256

# Database Connection Strings
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password-placeholder@db.your-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-db-password-placeholder@db.your-project-ref.supabase.co:5432/postgres

# LLM Providers & Fallback Gateway
LLM_PROVIDER_ORDER=openrouter,nvidia
LLM_REQUEST_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=5.0
LLM_MAX_DAILY_REQUEST_BUDGET=1000

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-placeholder
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_PRIMARY_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_APP_TITLE=AQG Studio
OPENROUTER_HTTP_REFERER=https://aqg.studio

# NVIDIA NIM Configuration
NVIDIA_API_KEY=your-nvidia-api-key-placeholder
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.3-70b-instruct

# Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
